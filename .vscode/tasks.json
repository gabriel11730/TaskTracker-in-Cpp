{ 
    "tasks": [ 
        { 
            "type": "cppbuild",
            "label": "C/C++: cl.exe compilar mi archivo activo",
            "command": "cl.exe",
            "args": [ 
                "/Zi", 
                "/EHsc",
                "/nologo",
                "/Zc:__cplusplus",
                "/std:c++17",
                "/I", "${workspaceFolder}",
                "${workspaceFolder}/main/*.cpp",   // Todos los .cpp en main
                "${workspaceFolder}/source/*.cpp", // Todos los .cpp en source
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarea generada por el depurador."
        }
    ],
    "version": "2.0.0"
}